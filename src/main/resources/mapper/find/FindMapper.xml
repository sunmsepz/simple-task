<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.simple.scheduling.metric.read.MetricReadMapper">

    <!-- Metric 전체 조회 -->
    <select id="findAll" resultType="MetricReadDTO">
        SELECT
        METRIC_ID
        , METRIC_NM
        , METRIC_VAL
        , CLCT_DT
        FROM
        KAFKA_METRIC
    </select>
</mapper>